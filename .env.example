# Application Configuration
APP_NAME="Clinical Knowledge Graph & Intelligent Document Assistant"
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
DEBUG=false

# Database Configuration (PostgreSQL or SQLite)
# For local development with SQLite fallback: sqlite:///./clinical_kg.db
# For PostgreSQL with Docker: postgresql://postgres:postgres@localhost:5432/clinical_kg_db
# For Docker Compose internal networking: postgresql://postgres:postgres@postgres:5432/clinical_kg_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clinical_kg_db

# Knowledge Graph & RAG Settings
TOP_K_CHUNKS=4
SIMILARITY_THRESHOLD=0.35
MAX_GRAPH_HOPS=2

# LLM Provider Configuration (Optional - falls back to deterministic grounded synthesis if keys not present)
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
EMBEDDING_PROVIDER=tfidf
